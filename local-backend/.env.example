# Database Configuration (SQLite)
DATABASE_DSN=./local_backend.db

# MySQL Configuration (for production)
IS_LOCAL=true
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=your_database_name

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672/
RABBITMQ_QUEUE=task_queue

# Claude API Configuration
CLAUDE_API_KEY=your-claude-api-key-here

# Claude CLI Configuration
CLAUDE_CLI_PATH=claude

# Repository Management
REPOSITORIES_BASE_DIR=/path/to/your/repositories

# GitHub API Configuration
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_TARGET_DIR=/Users/mac/project/git-repository/JokerTrickster
GITHUB_CLONE_TIMEOUT=300
GITHUB_MAX_REPOS_PER_REQUEST=100
GITHUB_TOKEN=your_github_personal_access_token_here

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=text

# Application Environment
APP_ENV=development

# AWS Configuration (when IS_LOCAL=false)
# AWS credentials will be loaded from AWS SSM Parameter Store:
# - dev_frog_mysql_user
# - dev_common_mysql_password
# - dev_common_mysql_host
# - dev_common_mysql_port
# - dev_frog_mysql_db