# RabbitMQ Integration Configuration
# Set USE_RABBITMQ=true to enable RabbitMQ instead of mock queue

# Enable RabbitMQ (set to true for production)
USE_RABBITMQ=false

# RabbitMQ Connection Settings
RABBITMQ_HOST=13.203.37.93
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Queue Configuration
RABBITMQ_QUEUE=claude-tasks
RABBITMQ_EXCHANGE=
RABBITMQ_ROUTING_KEY=claude-tasks

# Queue Settings
RABBITMQ_DURABLE=true
RABBITMQ_AUTO_DELETE=false
RABBITMQ_EXCLUSIVE=false
RABBITMQ_NO_WAIT=false

# Connection Management
RABBITMQ_RECONNECT_DELAY=5s
RABBITMQ_MAX_RETRIES=5

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=workflow
DB_CHARSET=utf8mb4

# GitHub Configuration
GITHUB_TOKEN=your_github_token
GITHUB_WEBHOOK_URL=https://your-domain.com/api/v1/github/webhook
