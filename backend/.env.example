# Local Backend Server Environment Variables

# Claude API Configuration
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4096

# Database Configuration (SQLite)
DATABASE_PATH=./data/workflow.db
DB_MAX_CONNECTIONS=10

# RabbitMQ Configuration
RABBITMQ_URL=amqp://13.203.37.93:5672
QUEUE_NAME=workflow_queue
MAX_RETRIES=3

# Server Configuration
SERVER_PORT=7000
SERVER_HOST=localhost
HEALTH_PORT=7001

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Application Settings
TIMEOUT_SECONDS=30

# Repository Management
REPOSITORIES_DIR=/Users/luxrobo/project/git-repository

# CORS Configuration
CORS_ORIGIN=http://13.203.37.93:4000

# GitHub Configuration
