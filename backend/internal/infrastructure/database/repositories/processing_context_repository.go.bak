package repositories

import (
	"context"

	"gorm.io/gorm"

	"local-backend-server/internal/domain/entities"
	"local-backend-server/internal/domain/repositories"
	dbModels "local-backend-server/internal/infrastructure/database/models"
)

// processingContextRepository implements the ProcessingContextRepository interface
type processingContextRepository struct {
	db *gorm.DB
}

// NewProcessingContextRepository creates a new processing context repository
func NewProcessingContextRepository(db *gorm.DB) repositories.ProcessingContextRepository {
	return &processingContextRepository{db: db}
}

// Create creates a new processing context
func (r *processingContextRepository) Create(ctx context.Context, context *entities.ProcessingContext) error {
	var tokenUsage dbModels.JSON
	if context.TokenUsage != nil {
		tokenUsage = dbModels.JSON{
			"input_tokens":  context.TokenUsage.InputTokens,
			"output_tokens": context.TokenUsage.OutputTokens,
			"total_tokens":  context.TokenUsage.TotalTokens,
		}
	}

	model := &dbModels.ProcessingContext{
		ID:           context.ID,
		RequestID:    context.RequestID,
		SessionID:    context.SessionID,
		SystemPrompt: context.SystemPrompt,
		Metadata:     dbModels.JSON(context.Metadata),
		TokenUsage:   tokenUsage,
		CreatedAt:    context.CreatedAt,
		UpdatedAt:    context.UpdatedAt,
	}
	
	return r.db.WithContext(ctx).Create(model).Error
}

// GetByID retrieves a processing context by its ID
func (r *processingContextRepository) GetByID(ctx context.Context, id string) (*entities.ProcessingContext, error) {
	var model dbModels.ProcessingContext
	err := r.db.WithContext(ctx).First(&model, "id = ?", id).Error
	if err != nil {
		if err == gorm.ErrRecordNotFound {
			return nil, nil
		}
		return nil, err
	}
	
	return r.modelToEntity(&model), nil
}

// GetByRequestID retrieves a processing context by request ID
func (r *processingContextRepository) GetByRequestID(ctx context.Context, requestID string) (*entities.ProcessingContext, error) {
	var model dbModels.ProcessingContext
	err := r.db.WithContext(ctx).First(&model, "request_id = ?", requestID).Error
	if err != nil {
		if err == gorm.ErrRecordNotFound {
			return nil, nil
		}
		return nil, err
	}
	
	return r.modelToEntity(&model), nil
}

// GetBySessionID retrieves processing contexts for a session
func (r *processingContextRepository) GetBySessionID(ctx context.Context, sessionID string) ([]*entities.ProcessingContext, error) {
	var dbModels []dbModels.ProcessingContext
	err := r.db.WithContext(ctx).
		Where("session_id = ?", sessionID).
		Order("created_at DESC").
		Find(&dbModels).Error
	if err != nil {
		return nil, err
	}
	
	contexts := make([]*entities.ProcessingContext, len(dbModels))
	for i, model := range dbModels {
		contexts[i] = r.modelToEntity(&model)
	}
	
	return contexts, nil
}

// Update updates an existing processing context
func (r *processingContextRepository) Update(ctx context.Context, context *entities.ProcessingContext) error {
	var tokenUsage dbModels.JSON
	if context.TokenUsage != nil {
		tokenUsage = dbModels.JSON{
			"input_tokens":  context.TokenUsage.InputTokens,
			"output_tokens": context.TokenUsage.OutputTokens,
			"total_tokens":  context.TokenUsage.TotalTokens,
		}
	}

	model := &dbModels.ProcessingContext{
		ID:           context.ID,
		RequestID:    context.RequestID,
		SessionID:    context.SessionID,
		SystemPrompt: context.SystemPrompt,
		Metadata:     dbModels.JSON(context.Metadata),
		TokenUsage:   tokenUsage,
		CreatedAt:    context.CreatedAt,
		UpdatedAt:    context.UpdatedAt,
	}
	
	return r.db.WithContext(ctx).Save(model).Error
}

// Delete deletes a processing context by ID
func (r *processingContextRepository) Delete(ctx context.Context, id string) error {
	return r.db.WithContext(ctx).Delete(&dbModels.ProcessingContext{}, "id = ?", id).Error
}

// GetLatestBySessionID retrieves the most recent processing context for a session
func (r *processingContextRepository) GetLatestBySessionID(ctx context.Context, sessionID string) (*entities.ProcessingContext, error) {
	var model dbModels.ProcessingContext
	err := r.db.WithContext(ctx).
		Where("session_id = ?", sessionID).
		Order("created_at DESC").
		First(&model).Error
	if err != nil {
		if err == gorm.ErrRecordNotFound {
			return nil, nil
		}
		return nil, err
	}
	
	return r.modelToEntity(&model), nil
}

// GetContextsWithMessages retrieves processing contexts with their conversation history
func (r *processingContextRepository) GetContextsWithMessages(ctx context.Context, sessionID string) ([]*entities.ProcessingContext, error) {
	var dbModels []dbModels.ProcessingContext
	err := r.db.WithContext(ctx).
		Where("session_id = ?", sessionID).
		Order("created_at DESC").
		Find(&dbModels).Error
	if err != nil {
		return nil, err
	}
	
	contexts := make([]*entities.ProcessingContext, len(dbModels))
	for i, model := range dbModels {
		context := r.modelToEntity(&model)
		
		// Load conversation history from messages table
		messages := []dbModels.Message{}
		err := r.db.WithContext(ctx).
			Where("session_id = ?", sessionID).
			Order("created_at ASC").
			Find(&messages).Error
		if err == nil {
			for _, msg := range messages {
				context.ConversationHistory = append(context.ConversationHistory, &entities.Message{
					ID:        msg.ID,
					SessionID: msg.SessionID,
					Type:      entities.MessageType(msg.Type),
					Role:      entities.MessageRole(msg.Role),
					Content:   msg.Content,
					Metadata:  entities.Metadata(msg.Metadata),
					CreatedAt: msg.CreatedAt,
					UpdatedAt: msg.UpdatedAt,
				})
			}
		}
		
		contexts[i] = context
	}
	
	return contexts, nil
}

// modelToEntity converts a database model to domain entity
func (r *processingContextRepository) modelToEntity(model *dbModels.ProcessingContext) *entities.ProcessingContext {
	context := &entities.ProcessingContext{
		ID:                  model.ID,
		RequestID:           model.RequestID,
		SessionID:           model.SessionID,
		SystemPrompt:        model.SystemPrompt,
		ConversationHistory: make([]*entities.Message, 0),
		Metadata:            map[string]interface{}(model.Metadata),
		CreatedAt:           model.CreatedAt,
		UpdatedAt:           model.UpdatedAt,
	}
	
	// Convert token usage if present
	if model.TokenUsage != nil {
		if inputTokens, ok := model.TokenUsage["input_tokens"].(float64); ok {
			if outputTokens, ok := model.TokenUsage["output_tokens"].(float64); ok {
				if totalTokens, ok := model.TokenUsage["total_tokens"].(float64); ok {
					context.TokenUsage = &entities.TokenUsage{
						InputTokens:  int(inputTokens),
						OutputTokens: int(outputTokens),
						TotalTokens:  int(totalTokens),
					}
				}
			}
		}
	}
	
	return context
}