[Unit]
Description=Workflow Backend Server
After=network.target mysql.service rabbitmq-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/workflow
ExecStart=/opt/workflow/server
Restart=always
RestartSec=10

# Environment variables
Environment="PORT=7000"
Environment="GIN_MODE=release"

# Logging
StandardOutput=append:/var/log/workflow-backend/server.log
StandardError=append:/var/log/workflow-backend/error.log

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/workflow /var/log/workflow-backend

[Install]
WantedBy=multi-user.target
